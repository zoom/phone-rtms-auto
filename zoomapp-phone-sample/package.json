{
  "name": "zoomapp-phone-sample",
  "version": "1.0.0",
  "description": "Minimal working Zoom App for Phone with OAuth",
  "private": true,
  "scripts": {
    "start": "docker-compose up",
    "stop": "docker-compose down",
    "restart": "docker-compose restart",
    "logs": "docker-compose logs -f",
    "logs:backend": "docker-compose logs -f backend",
    "logs:rtms": "docker-compose logs -f rtms",
    "logs:frontend": "docker-compose logs -f frontend",
    "build": "docker-compose build",
    "rebuild": "docker-compose down -v && docker-compose build && docker-compose up",
    "clean": "docker-compose down -v",
    "clean:all": "docker-compose down -v && docker system prune -f",
    "health": "curl http://localhost:3001/health",
    "ngrok": "ngrok http 3001",
    "ngrok:rtms": "ngrok http 3002"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zoom/zoomapp-phone-sample.git"
  },
  "keywords": [
    "zoom",
    "zoom-apps",
    "phone"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
